#!/usr/bin/env python3
"""Abre, lista, manda mensagem e fecha as sessões do Claude Code em modo chat no BrzA Studio, pelo nome.

O chat não tem `--name`, então o primeiro prompt é `/rename <nome>`, e o prompt da tarefa entra logo depois pelo
`agentSession.send` do runtime, com `delivery: 'queue-if-active'`: ele espera na fila até o /rename terminar.

O chat não passa pelo zsh de login, e a função `claude` do ~/.zshrc não roda. No brza-workspace isso não falta: o chat
lê o `.claude/settings.json` do projeto pelo `--setting-sources`. Num checkout do brza-studio, os hooks e a identidade só
chegam pelo `agentCmdOverrides.claude` apontado para o claude-brza; sem ele, o script avisa numa linha CHECK e abre
assim mesmo.

Sessão cujo nome já roda é pulada. O nome vem de <config>/sessions/<pid>.json, que o /rename grava; o config é o
~/.claude ou o de uma conta do app, em <dados do app>/claude-profiles/<id>/home.

O list, o send e o close acham o chat pelo nome: para cada aba de chat do app, o `agentSession.history` dá o id da
sessão do Claude, e o nome é o último /rename gravado no transcript dela (<config>/projects/*/<id>.jsonl). O título da
aba é outro: é o nome do chat no app. Chat sem /rename não tem nome e não é achado.

O send respeita a trava de retomada (.claude/hooks/resume_guard.py): a sessão parada além do TTL do cache e com 150 mil
tokens ou mais não recebe nada sem --wake, que grava a passagem na trava e manda uma vez.

Uso:
  brza sessions <nome>                                  # abre o chat no brza-workspace; o `open` é opcional
  brza sessions <nome> --prompt "<tarefa>"              # e manda a tarefa depois do /rename
  brza sessions <nome> --prompt-file <arquivo>          # a tarefa lida de um arquivo
  brza sessions <nome> --checkout <caminho>             # noutro checkout, como um worktree do brza-studio
  brza sessions <nome> --wait                           # só anuncia depois que o /rename registra o nome
  brza sessions <nome> --dry-run                        # só mostra o que faria
  brza sessions list [--json]                           # os chats do app: nome, estado, chat, worktree, trava
  brza sessions send <nome> <texto> [--wake] [--json]   # manda ao chat, na fila se ele estiver num turno
  brza sessions close <nome> [--force] [--json]         # fecha o chat e a aba; o chat num turno pede --force

As linhas de saída do open são `open:     <nome>  (chat, <caminho>, <sessionId>)`, `running:  <nome>` e `CHECK:    …`.
Saídas: 0 feito; 1 nome ausente ou repetido, chat num turno sem --force, ou o app sem resposta; 3 o send recusado pela
trava. O --json do list, do send e do close é o contrato do roteador do PLN-003:
  list   {"sessions": [{"name", "title", "chat", "claude_session", "worktree", "state", "guard"}]}
  send   {"sent": true, "name", "chat"}; na trava, {"sent": false, "name", "chat", "guard": {…}}
  close  {"closed": true, "name", "chat"}; num turno, {"closed": false, "name", "chat", "state"}
  erro   {"error": "<motivo>"}
"""
import argparse
import importlib
import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from brza_runtime import (WORKSPACE, BrzaError, brza, canonicalize, rpc, send_to_chat,  # noqa: E402,F401
                          user_data)

CHAT_COMMAND = 'claude-brza'
HOOKS = WORKSPACE / '.claude' / 'hooks'
VERBS = ('open', 'list', 'send', 'close')


def config_dirs() -> list[Path]:
    return [Path.home() / '.claude', *sorted((user_data() / 'claude-profiles').glob('*/home'))]


def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def running(name: str) -> bool:
    for config in config_dirs():
        for file in (config / 'sessions').glob('*.json'):
            try:
                data = json.loads(file.read_text())
                pid = int(data.get('pid') or file.stem)
            except (OSError, ValueError):
                continue
            if data.get('name') == name and alive(pid):
                return True
    return False


def chat_blocker(checkout: Path) -> str | None:
    """Por que o chat nesse checkout sobe sem os hooks do workspace, ou None quando sobe com eles."""
    if checkout == WORKSPACE or WORKSPACE in checkout.parents:
        return None
    try:
        override = rpc('settings.getAgentLaunch')['settings'].get('agentCmdOverrides', {}).get('claude')
    except (BrzaError, KeyError) as e:
        return f'não li a configuração do app ({e})'
    if not override:
        return f'agentCmdOverrides.claude está vazio, e o chat em {checkout} sobe sem os hooks do workspace'
    if Path(override).name != CHAT_COMMAND:
        return f'agentCmdOverrides.claude é {override}, não o {CHAT_COMMAND}'
    return None


def wait_for_name(name: str, timeout: float = 60.0) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if running(name):
            return True
        time.sleep(1)
    return False


def provider_session(chat: str) -> str | None:
    """O id da sessão do Claude por trás do chat, ou None quando o app não o dá."""
    try:
        found = rpc('agentSession.history', {'sessionId': chat, 'direction': 'tail', 'limit': 1})
    except BrzaError:
        return None
    return (found.get('providerSession') or {}).get('id')


def chat_name(claude_session: str) -> str | None:
    """O último /rename da sessão, gravado no transcript como `custom-title`."""
    name = None
    for config in config_dirs():
        for transcript in (config / 'projects').glob(f'*/{claude_session}.jsonl'):
            try:
                with transcript.open('rb') as f:
                    for line in f:
                        if b'"custom-title"' not in line:
                            continue
                        try:
                            row = json.loads(line)
                        except ValueError:
                            continue
                        if row.get('type') == 'custom-title' and row.get('customTitle'):
                            name = row['customTitle']
            except OSError:
                continue
    return name


def guard_module():
    if str(HOOKS) not in sys.path:
        sys.path.insert(0, str(HOOKS))
    return importlib.import_module('resume_guard')


def pending_guard(claude_session: str) -> dict | None:
    """O que a trava diria de um prompt à sessão agora: None quando passa; senão os minutos parada, o TTL, o contexto
    e o custo estimado da regravação."""
    guard = guard_module()
    found = guard.pending(claude_session, time.time())
    if not found:
        return None
    cost = guard.rewrite_cost(found['model'], found['context'], found['ttl_min'])
    return {'idle_min': found['idle_min'], 'ttl_min': found['ttl_min'], 'context': found['context'],
            'cost_usd': round(cost, 2) if cost is not None else None}


def hold_guard(claude_session: str, text: str):
    guard_module().hold(claude_session, text, time.time())


def chats() -> list[dict]:
    """Os chats abertos no app, na ordem das abas; `tab` e `selector` ficam fora do --json."""
    found = []
    for snapshot in rpc('session.tabs.listAll')['snapshots']:
        worktree = snapshot['worktree'].split('::', 1)[-1]
        for tab in snapshot.get('tabs', []):
            if tab.get('type') != 'agent-session':
                continue
            claude_session = provider_session(tab['sessionId'])
            found.append({'name': chat_name(claude_session) if claude_session else None, 'title': tab.get('title'),
                          'chat': tab['sessionId'], 'claude_session': claude_session, 'worktree': worktree,
                          'state': (tab.get('chatStatus') or {}).get('state'), 'tab': tab['id']})
    return found


def public(chat: dict) -> dict:
    return {k: v for k, v in chat.items() if k != 'tab'}


def find(name: str) -> dict:
    matches = [chat for chat in chats() if chat['name'] == name]
    if not matches:
        raise BrzaError(f'nenhum chat aberto se chama {name}; veja `brza sessions list`')
    if len(matches) > 1:
        raise BrzaError(f'{len(matches)} chats se chamam {name}: ' + ', '.join(c['chat'] for c in matches))
    return matches[0]


def emit(as_json: bool, data: dict, line: str):
    print(json.dumps(data, ensure_ascii=False) if as_json else line)


def describe(guard: dict) -> str:
    cost = f', cerca de US$ {guard["cost_usd"]:.2f}'.replace('.', ',') if guard.get('cost_usd') is not None else ''
    context = f'{guard["context"]:,}'.replace(',', '.')
    return (f'parada há {guard["idle_min"]} min, e o cache dura {guard["ttl_min"]} min: o próximo pedido regrava '
            f'{context} tokens{cost}')


def list_command(args) -> int:
    found = [dict(chat, guard=pending_guard(chat['claude_session']) if chat['claude_session'] else None)
             for chat in chats()]
    if args.json:
        print(json.dumps({'sessions': [public(chat) for chat in found]}, ensure_ascii=False))
        return 0
    for chat in found:
        print(f'{chat["name"] or "-":<24} {chat["state"] or "-":<9} {chat["chat"]}  {chat["worktree"]}  '
              f'{chat["title"]}')
        if chat['guard']:
            print(f'{"":<24} trava: {describe(chat["guard"])}')
    return 0


def send_command(args) -> int:
    chat = find(args.name)
    guard = pending_guard(chat['claude_session'])
    if guard and not args.wake:
        emit(args.json, {'sent': False, 'name': chat['name'], 'chat': chat['chat'], 'guard': guard},
             f'GUARD:    {chat["name"]}: {describe(guard)}. Abra sessão nova, ou repita com --wake para acordá-la.')
        return 3
    if guard:
        hold_guard(chat['claude_session'], args.text)
    send_to_chat(chat['chat'], args.text)
    emit(args.json, {'sent': True, 'name': chat['name'], 'chat': chat['chat']},
         f'sent:     {chat["name"]}  ({chat["chat"]})')
    return 0


def close_command(args) -> int:
    chat = find(args.name)
    if chat['state'] == 'working' and not args.force:
        emit(args.json, {'closed': False, 'name': chat['name'], 'chat': chat['chat'], 'state': chat['state']},
             f'CHECK:    {chat["name"]} está no meio de um turno; repita com --force para fechar assim mesmo')
        return 1
    # O agentSession.close encerra o processo e deixa a aba; o session.tabs.close tira a aba. Nunca --resume.
    rpc('agentSession.close', {'sessionId': chat['chat']})
    rpc('session.tabs.close', {'worktree': f'path:{chat["worktree"]}', 'tabId': chat['tab'], 'reason': 'user'})
    emit(args.json, {'closed': True, 'name': chat['name'], 'chat': chat['chat']},
         f'closed:   {chat["name"]}  ({chat["chat"]})')
    return 0


def by_name(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog='brza sessions', description='Lista, manda mensagem e fecha chats pelo nome.')
    verbs = ap.add_subparsers(dest='verb', required=True)
    listing = verbs.add_parser('list', help='os chats do app')
    listing.add_argument('--json', action='store_true')
    send = verbs.add_parser('send', help='manda o texto ao chat')
    send.add_argument('name')
    send.add_argument('text')
    send.add_argument('--wake', action='store_true', help='acorda a sessão que a trava de retomada barraria')
    send.add_argument('--json', action='store_true')
    close = verbs.add_parser('close', help='fecha o chat e a aba, sem --resume')
    close.add_argument('name')
    close.add_argument('--force', action='store_true', help='fecha também o chat no meio de um turno')
    close.add_argument('--json', action='store_true')
    args = ap.parse_args(argv)
    try:
        return {'list': list_command, 'send': send_command, 'close': close_command}[args.verb](args)
    except BrzaError as e:
        emit(args.json, {'error': str(e)}, f'CHECK:    {e}')
        return 1


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in VERBS[1:]:
        return by_name(argv)
    if argv and argv[0] == 'open':
        argv = argv[1:]
    ap = argparse.ArgumentParser(prog='brza sessions', description=__doc__.split('\n\n')[0],
                                 epilog='Os outros verbos: brza sessions list|send|close --help.')
    ap.add_argument('name')
    ap.add_argument('--checkout', type=Path, default=WORKSPACE)
    group = ap.add_mutually_exclusive_group()
    group.add_argument('--prompt')
    group.add_argument('--prompt-file', type=Path)
    ap.add_argument('--wait', action='store_true', help='espera o /rename registrar o nome antes de anunciar')
    ap.add_argument('--dry-run', action='store_true')
    args = ap.parse_args(argv)

    checkout = args.checkout.expanduser().resolve()
    prompt = args.prompt_file.read_text().strip() if args.prompt_file else (args.prompt or '').strip()
    if running(args.name):
        print(f'running:  {args.name}')
        return 0
    if blocker := chat_blocker(checkout):
        print(f'CHECK:    {args.name}: {blocker}')
    if args.dry_run:
        print(f'abriria:  {args.name}  (chat, {checkout}){", com prompt" if prompt else ""}')
        return 0

    try:
        launched = brza('agent', 'launch', '--agent', 'claude', '--surface', 'chat', '--worktree', f'path:{checkout}',
                        '--prompt', f'/rename {args.name}')
    except BrzaError as e:
        print(f'CHECK:    {args.name} não abriu: {e}')
        return 1
    outcome = launched.get('outcome') or {}
    if outcome.get('kind') != 'structured' or not outcome.get('sessionId'):
        detail = (launched.get('receipt') or {}).get('detail') or 'sem motivo'
        print(f'CHECK:    {args.name} abriu como {outcome.get("kind")}, não como chat: {detail}')
        return 1
    session_id = outcome['sessionId']
    if prompt:
        try:
            send_to_chat(session_id, prompt)
        except BrzaError as e:
            print(f'CHECK:    {args.name} abriu, mas o prompt não entrou: {e}')
            return 1
    if args.wait and not wait_for_name(args.name):
        print(f'CHECK:    {args.name} não registrou o nome em 60 s; confira o /rename na aba')
        return 1
    print(f'open:     {args.name}  (chat, {checkout}, {session_id})')
    return 0


if __name__ == '__main__':
    sys.exit(main())
